[workspace]
resolver = "2"
members = [
  "crates/{{ context.app_name }}-domain",
  "crates/{{ context.app_name }}-ports",
  "crates/{{ context.app_name }}-services",
  "crates/{{ context.app_name }}-api",
  "crates/{{ context.app_name }}-postgres",
  "crates/{{ context.app_name }}-bin",
{% if context.worker %}  "crates/{{ context.app_name }}-worker",
{% endif %}]

[workspace.package]
version = "0.1.0"
edition = "2024"
rust-version = "1.95"
publish = false

[workspace.dependencies]
axum = "=0.8.9"
{{ context.baukit_dependencies }}
{% if context.auth_oidc %}{% if 'source = "path"' in context.baukit_manifest %}{% set baukit_path = context.baukit_manifest | replace('source = "path"\npath = "', '') | replace('"', '') %}baukit-ratelimit = { path = "{{ baukit_path }}/crates/baukit-ratelimit" }
{% else %}baukit-ratelimit = "{{ context.template_version }}"
{% endif %}{% endif %}serde = { version = "=1.0.229", features = ["derive"] }
serde_json = "=1.0.151"
sqlx = { version = "=0.9.0", default-features = false, features = ["runtime-tokio", "tls-rustls", "postgres", "uuid", "migrate"] }
thiserror = "=2.0.20"
tokio = { version = "=1.53.1", features = ["full"] }
tower = { version = "=0.5.3", features = ["util"] }
utoipa = { version = "=5.5.0", features = ["uuid"] }
uuid = { version = "=1.24.0", features = ["v4", "v7", "serde"] }

{{ context.app_crate }}-domain = { path = "crates/{{ context.app_name }}-domain" }
{{ context.app_crate }}-ports = { path = "crates/{{ context.app_name }}-ports" }
{{ context.app_crate }}-services = { path = "crates/{{ context.app_name }}-services" }
{{ context.app_crate }}-api = { path = "crates/{{ context.app_name }}-api" }
{{ context.app_crate }}-postgres = { path = "crates/{{ context.app_name }}-postgres" }
{% if context.worker %}{{ context.app_crate }}-worker = { path = "crates/{{ context.app_name }}-worker" }
{% endif %}

[workspace.lints.rust]
unsafe_code = "deny"

[workspace.lints.clippy]
all = { level = "warn", priority = -1 }
dbg_macro = "warn"
todo = "warn"
unwrap_used = "warn"
