{% macro shape_mappers() %}{% if context.auth_clerk %}[
        {
          "name": "clerk session version",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-hardcoded-claim-mapper",
          "consentRequired": false,
          "config": {"claim.name": "v", "claim.value": "2", "jsonType.label": "int", "access.token.claim": "true", "id.token.claim": "false", "userinfo.token.claim": "false", "introspection.token.claim": "true"}
        },
        {
          "name": "clerk active organization",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-hardcoded-claim-mapper",
          "consentRequired": false,
          "config": {"claim.name": "o", "claim.value": "{\"id\":\"org_local\",\"rol\":\"admin\",\"slg\":\"local\"}", "jsonType.label": "JSON", "access.token.claim": "true", "id.token.claim": "false", "userinfo.token.claim": "false", "introspection.token.claim": "true"}
        },
        {
          "name": "clerk sign-in time",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usersessionmodel-note-mapper",
          "consentRequired": false,
          "config": {"user.session.note": "AUTH_TIME", "claim.name": "session_created_at", "jsonType.label": "long", "access.token.claim": "true", "id.token.claim": "false", "userinfo.token.claim": "false", "introspection.token.claim": "true"}
        }
      ]{% else %}[
        {
          "name": "workos client id",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-hardcoded-claim-mapper",
          "consentRequired": false,
          "config": {"claim.name": "client_id", "claim.value": "client_{{ context.app_crate }}_local", "jsonType.label": "String", "access.token.claim": "true", "id.token.claim": "false", "userinfo.token.claim": "false", "introspection.token.claim": "true"}
        },
        {
          "name": "workos organization",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-hardcoded-claim-mapper",
          "consentRequired": false,
          "config": {"claim.name": "org_id", "claim.value": "org_local", "jsonType.label": "String", "access.token.claim": "true", "id.token.claim": "false", "userinfo.token.claim": "false", "introspection.token.claim": "true"}
        },
        {
          "name": "workos role",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-hardcoded-claim-mapper",
          "consentRequired": false,
          "config": {"claim.name": "role", "claim.value": "admin", "jsonType.label": "String", "access.token.claim": "true", "id.token.claim": "false", "userinfo.token.claim": "false", "introspection.token.claim": "true"}
        },
        {
          "name": "workos permissions",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-hardcoded-claim-mapper",
          "consentRequired": false,
          "config": {"claim.name": "permissions", "claim.value": "[\"items:read\",\"items:write\"]", "jsonType.label": "JSON", "access.token.claim": "true", "id.token.claim": "false", "userinfo.token.claim": "false", "introspection.token.claim": "true"}
        }
      ]{% endif %}{% endmacro %}{% macro backend_audience() %}[
        {
          "name": "backend audience",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "consentRequired": false,
          "config": {
            "included.client.audience": "{{ context.app_name }}-backend",
            "access.token.claim": "true"
          }
        }
      ]{% endmacro %}{
  "realm": "{{ context.app_name }}",
  "displayName": "{{ context.app_name }} local development",
  "enabled": true,
  "sslRequired": "none",
  "registrationAllowed": false,
  "loginWithEmailAllowed": true,
  "loginTheme": "baukit-accessible",
  "passwordPolicy": "length(12) and notUsername and notEmail and maxLength(128)",
  "bruteForceProtected": true,
  "accessTokenLifespan": 300,
  "offlineSessionIdleTimeout": 2592000,
  "offlineSessionMaxLifespanEnabled": true,
  "offlineSessionMaxLifespan": 7776000,
  "users": [
    {
      "username": "service-account-{{ context.app_name }}-backend",
      "serviceAccountClientId": "{{ context.app_name }}-backend",
      "enabled": true,
      "clientRoles": {"realm-management": ["manage-users"]}
    },
    {
      "username": "test",
      "email": "test@{{ context.app_name }}.local",
      "emailVerified": true,
      "enabled": true,
      "firstName": "Test",
      "lastName": "User",
{% if context.web or context.mobile %}      "realmRoles": ["offline_access"],
{% endif %}      "credentials": [{ "type": "password", "value": "development-password", "temporary": false }]
    }
  ],
{% if context.mcp %}  "clientScopes": {{ context.remote_mcp_client_scopes | indent(2) }},
  "defaultDefaultClientScopes": ["profile", "email", "roles", "web-origins", "acr", "basic"],
  "defaultOptionalClientScopes": ["offline_access", "address", "phone", "microprofile-jwt", "organization"],
{% endif %}  "clients": [
    {
      "clientId": "{{ context.app_name }}-backend",
      "name": "Backend confidential client",
      "enabled": true,
      "clientAuthenticatorType": "client-secret",
      "secret": "local-backend-secret",
      "publicClient": false,
      "standardFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": true,
      "protocol": "openid-connect",
      "protocolMappers": [
        {
          "name": "backend audience",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "consentRequired": false,
          "config": {
            "included.client.audience": "{{ context.app_name }}-backend",
            "access.token.claim": "true"
          }
        }
      ]
    }{% if context.mcp %},
    {
      "clientId": "{{ context.app_name }}-mcp",
      "name": "MCP public PKCE client",
      "enabled": true,
      "publicClient": true,
      "standardFlowEnabled": true,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": false,
      "redirectUris": ["http://localhost:18888/callback", "http://127.0.0.1:18888/callback", "https://claude.ai/api/mcp/auth_callback"],
      "webOrigins": [],
      "attributes": { "pkce.code.challenge.method": "S256" },
      "protocol": "openid-connect",
      "defaultClientScopes": ["basic"],
      "optionalClientScopes": ["items:read"],
      "protocolMappers": [
{% if context.auth_clerk %}        {
          "name": "clerk oauth client id",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-hardcoded-claim-mapper",
          "consentRequired": false,
          "config": {"claim.name": "client_id", "claim.value": "{{ context.app_name }}-mcp", "jsonType.label": "String", "access.token.claim": "true", "id.token.claim": "false", "userinfo.token.claim": "false", "introspection.token.claim": "true"}
        }
{% else %}        {
          "name": "MCP resource audience",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "consentRequired": false,
          "config": {"included.custom.audience": "http://localhost:{{ context.api_host_port }}/mcp", "access.token.claim": "true", "id.token.claim": "false"}
        }
{% endif %}      ]
    }{% endif %}{% if not context.auth_oidc %},
    {
      "clientId": "{{ context.app_name }}-local",
      "name": "Local {{ context.auth_provider }}-shaped PKCE client",
      "enabled": true,
      "publicClient": true,
      "standardFlowEnabled": true,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": false,
      "redirectUris": ["http://127.0.0.1:{{ context.local_callback_port }}/callback"],
      "webOrigins": [],
      "attributes": { "pkce.code.challenge.method": "S256" },
      "protocol": "openid-connect",
      "fullScopeAllowed": false,
      "defaultClientScopes": ["basic"],
      "optionalClientScopes": [],
      "protocolMappers": {{ shape_mappers() }}
    }{% endif %}{% if context.web or context.pwa %},
    {
      "clientId": "{{ context.app_name }}-web",
      "name": "Web public PKCE client, redeemed by the backend /auth/session",
      "enabled": true,
      "publicClient": true,
      "standardFlowEnabled": true,
      "directAccessGrantsEnabled": false,
      "redirectUris": [{% for port in context.web_origin_ports %}"http://localhost:{{ port }}/*"{{ ", " if not loop.last }}{% endfor %}],
      "webOrigins": [{% for port in context.web_origin_ports %}"http://localhost:{{ port }}"{{ ", " if not loop.last }}{% endfor %}],
      "attributes": { "pkce.code.challenge.method": "S256", "post.logout.redirect.uris": "+" },
      "protocol": "openid-connect",
{% if context.auth_oidc %}      "protocolMappers": {{ backend_audience() }}
{% else %}      "fullScopeAllowed": false,
      "defaultClientScopes": ["basic"],
      "optionalClientScopes": [],
      "protocolMappers": {{ shape_mappers() }}
{% endif %}    }{% endif %}{% if context.mobile %},
    {
      "clientId": "{{ context.app_name }}-mobile",
      "name": "Mobile public PKCE client",
      "enabled": true,
      "publicClient": true,
      "standardFlowEnabled": true,
      "directAccessGrantsEnabled": false,
      "redirectUris": ["{{ context.app_name }}://oauth"],
      "webOrigins": [],
      "attributes": { "pkce.code.challenge.method": "S256" },
      "protocol": "openid-connect",
{% if context.auth_oidc %}      "protocolMappers": {{ backend_audience() }}
{% else %}      "fullScopeAllowed": false,
      "defaultClientScopes": ["basic"],
      "optionalClientScopes": [],
      "protocolMappers": {{ shape_mappers() }}
{% endif %}    }{% endif %}
  ]
}
