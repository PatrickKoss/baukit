{
  "components": {
    "schemas": {
      "DailyFactDto": {
        "properties": {
          "date": {
            "format": "date",
            "type": "string"
          },
          "entries": {
            "format": "int32",
            "minimum": 0,
            "type": "integer"
          },
          "hour_histogram": {
            "items": {
              "format": "int32",
              "minimum": 0,
              "type": "integer"
            },
            "type": "array"
          },
          "mood_tags": {
            "additionalProperties": {
              "additionalProperties": {
                "format": "int32",
                "minimum": 0,
                "type": "integer"
              },
              "propertyNames": {
                "type": "string"
              },
              "type": "object"
            },
            "propertyNames": {
              "type": "string"
            },
            "type": "object"
          },
          "moods": {
            "additionalProperties": {
              "format": "int32",
              "minimum": 0,
              "type": "integer"
            },
            "propertyNames": {
              "type": "string"
            },
            "type": "object"
          },
          "tags": {
            "additionalProperties": {
              "format": "int32",
              "minimum": 0,
              "type": "integer"
            },
            "propertyNames": {
              "type": "string"
            },
            "type": "object"
          },
          "template_runs": {
            "additionalProperties": {
              "format": "int32",
              "minimum": 0,
              "type": "integer"
            },
            "propertyNames": {
              "format": "uuid",
              "type": "string"
            },
            "type": "object"
          },
          "words": {
            "format": "int32",
            "minimum": 0,
            "type": "integer"
          }
        },
        "required": [
          "date",
          "hour_histogram",
          "entries",
          "words",
          "moods",
          "tags",
          "mood_tags",
          "template_runs"
        ],
        "type": "object"
      },
      "ErrorBody": {
        "description": "The error body nested inside [`ErrorEnvelope`].",
        "properties": {
          "code": {
            "description": "Stable, machine-readable error code.",
            "type": "string"
          },
          "details": {
            "additionalProperties": {},
            "description": "Structured product- or validation-specific error details.",
            "propertyNames": {
              "type": "string"
            },
            "type": "object"
          },
          "message": {
            "description": "Safe user-facing or intentionally generic message.",
            "type": "string"
          },
          "request_id": {
            "description": "Request identifier shared with logs and support tooling.",
            "type": "string"
          }
        },
        "required": [
          "code",
          "message",
          "request_id",
          "details"
        ],
        "type": "object"
      },
      "ErrorEnvelope": {
        "description": "The shared public error response envelope.\n\nThis type deliberately has no HTTP-framework dependency so runtime crates can serialize and\nreuse it directly.",
        "properties": {
          "error": {
            "$ref": "#/components/schemas/ErrorBody",
            "description": "The structured public error."
          }
        },
        "required": [
          "error"
        ],
        "type": "object"
      },
      "ProgramRunPageDto": {
        "properties": {
          "next_cursor": {
            "type": [
              "string",
              "null"
            ]
          },
          "runs": {
            "items": {
              "$ref": "#/components/schemas/ProgramRunSummaryDto"
            },
            "type": "array"
          }
        },
        "required": [
          "runs",
          "next_cursor"
        ],
        "type": "object"
      },
      "ProgramRunStatusDto": {
        "enum": [
          "active",
          "completed"
        ],
        "type": "string"
      },
      "ProgramRunSummaryDto": {
        "properties": {
          "completed_at": {
            "format": "date-time",
            "type": [
              "string",
              "null"
            ]
          },
          "entry_id": {
            "format": "uuid",
            "type": [
              "string",
              "null"
            ]
          },
          "id": {
            "format": "uuid",
            "type": "string"
          },
          "program_id": {
            "format": "uuid",
            "type": "string"
          },
          "started_at": {
            "format": "date-time",
            "type": "string"
          },
          "status": {
            "$ref": "#/components/schemas/ProgramRunStatusDto"
          }
        },
        "required": [
          "id",
          "program_id",
          "status",
          "started_at",
          "completed_at",
          "entry_id"
        ],
        "type": "object"
      },
      "SaveSectionResponseRequest": {
        "additionalProperties": false,
        "properties": {
          "answered": {
            "type": "boolean"
          },
          "body_markdown": {
            "description": "1 to 20000 Unicode scalar values after trimming; the deployment limit may be narrower.",
            "type": "string"
          },
          "expected_revision": {
            "format": "int64",
            "minimum": 0,
            "type": "integer"
          }
        },
        "required": [
          "body_markdown",
          "expected_revision"
        ],
        "type": "object"
      },
      "SectionResponseDto": {
        "properties": {
          "answered": {
            "type": "boolean"
          },
          "body_markdown": {
            "type": "string"
          },
          "revision": {
            "format": "int64",
            "minimum": 0,
            "type": "integer"
          },
          "section_id": {
            "format": "uuid",
            "type": "string"
          }
        },
        "required": [
          "section_id",
          "body_markdown",
          "revision",
          "answered"
        ],
        "type": "object"
      }
    }
  },
  "info": {
    "title": "Excerpt API",
    "version": "0.0.0"
  },
  "openapi": "3.1.0",
  "paths": {
    "/v1/program-runs": {
      "get": {
        "operationId": "list_program_runs",
        "parameters": [
          {
            "in": "query",
            "name": "status",
            "required": false,
            "schema": {
              "$ref": "#/components/schemas/ProgramRunStatusDto"
            }
          },
          {
            "in": "query",
            "name": "program_id",
            "required": false,
            "schema": {
              "format": "uuid",
              "type": "string"
            }
          },
          {
            "in": "query",
            "name": "limit",
            "required": false,
            "schema": {
              "format": "int32",
              "maximum": 100,
              "minimum": 1,
              "type": "integer"
            }
          },
          {
            "in": "query",
            "name": "cursor",
            "required": false,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProgramRunPageDto"
                }
              }
            },
            "description": "Program runs ordered by descending identifier",
            "headers": {
              "Cache-Control": {
                "description": "Always `no-store` for personal API responses.",
                "schema": {
                  "type": "string"
                }
              }
            }
          },
          "400": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            },
            "description": "Invalid program run filters",
            "headers": {
              "Cache-Control": {
                "description": "Always `no-store` for personal API responses.",
                "schema": {
                  "type": "string"
                }
              }
            }
          }
        },
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "tags": [
          "program runs"
        ]
      }
    },
    "/v1/program-runs/{run_id}/sections/{section_id}/response": {
      "put": {
        "operationId": "save_section_response",
        "parameters": [
          {
            "description": "Program run identifier",
            "in": "path",
            "name": "run_id",
            "required": true,
            "schema": {
              "format": "uuid",
              "type": "string"
            }
          },
          {
            "description": "Program section identifier",
            "in": "path",
            "name": "section_id",
            "required": true,
            "schema": {
              "format": "uuid",
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/SaveSectionResponseRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SectionResponseDto"
                }
              }
            },
            "description": "Section response saved with its new revision",
            "headers": {
              "Cache-Control": {
                "description": "Always `no-store` for personal API responses.",
                "schema": {
                  "type": "string"
                }
              }
            }
          },
          "400": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            },
            "description": "Invalid section response",
            "headers": {
              "Cache-Control": {
                "description": "Always `no-store` for personal API responses.",
                "schema": {
                  "type": "string"
                }
              }
            }
          }
        },
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "tags": [
          "program runs"
        ]
      }
    }
  }
}
