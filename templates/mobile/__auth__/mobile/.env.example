{% if context.auth_oidc %}EXPO_PUBLIC_API_URL=http://localhost:{{ context.api_host_port }}
EXPO_PUBLIC_OIDC_ISSUER=http://localhost:{{ context.keycloak_host_port }}/realms/{{ context.app_name }}
EXPO_PUBLIC_OIDC_CLIENT_ID={{ context.app_name }}-mobile
EXPO_PUBLIC_OIDC_AUDIENCE=
EXPO_PUBLIC_OIDC_RESOURCE=
EXPO_PUBLIC_OIDC_SCOPES=openid profile email
EXPO_PUBLIC_OIDC_OFFLINE_ACCESS=true
{% elif context.auth_clerk %}EXPO_PUBLIC_API_URL=http://localhost:{{ context.api_host_port }}
EXPO_PUBLIC_CLERK_PUBLISHABLE_KEY=
EXPO_PUBLIC_LOCAL_OIDC_ISSUER=http://localhost:{{ context.keycloak_host_port }}/realms/{{ context.app_name }}
{% else %}EXPO_PUBLIC_API_URL=http://localhost:{{ context.api_host_port }}
EXPO_PUBLIC_WORKOS_CLIENT_ID=
EXPO_PUBLIC_WORKOS_API_HOSTNAME=api.workos.com
EXPO_PUBLIC_WORKOS_REDIRECT_URI={{ context.app_name }}://oauth
EXPO_PUBLIC_LOCAL_OIDC_ISSUER=http://localhost:{{ context.keycloak_host_port }}/realms/{{ context.app_name }}
{% endif -%}
EXPO_PUBLIC_REVENUECAT_IOS_API_KEY=
EXPO_PUBLIC_REVENUECAT_ANDROID_API_KEY=
EXPO_PUBLIC_REVENUECAT_OFFERING_ID=
