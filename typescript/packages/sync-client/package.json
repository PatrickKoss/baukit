{
  "name": "@baukit/sync-client",
  "version": "0.6.0",
  "description": "Client-side scheduling, transport, status reporting, and ordering for offline-capable sync loops.",
  "license": "MIT",
  "author": "Patrick Koss",
  "homepage": "https://github.com/PatrickKoss/baukit#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/PatrickKoss/baukit.git",
    "directory": "typescript/packages/sync-client"
  },
  "bugs": {
    "url": "https://github.com/PatrickKoss/baukit/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "engines": {
    "node": ">=24.0.0"
  },
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./hlc": {
      "types": "./dist/hlc.d.ts",
      "import": "./dist/hlc.js",
      "default": "./dist/hlc.js"
    },
    "./expo": {
      "types": "./dist/expo.d.ts",
      "import": "./dist/expo.js",
      "default": "./dist/expo.js"
    },
    "./browser": {
      "types": "./dist/browser.d.ts",
      "import": "./dist/browser.js",
      "default": "./dist/browser.js"
    },
    "./conformance": {
      "types": "./dist/conformance.d.ts",
      "import": "./dist/conformance.js",
      "default": "./dist/conformance.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "prepare": "pnpm run build",
    "test": "tsc -p tsconfig.test.json && tsc -p tsconfig.exports.json && vitest run --config ../../vitest.config.ts && node ../../scripts/test-packed-exports.mjs",
    "lint": "eslint src --max-warnings=0",
    "format:check": "prettier --check src type-tests package.json tsconfig*.json"
  },
  "devDependencies": {
    "@types/node": "26.6.4",
    "expo-network": "57.0.2",
    "react-native": "0.86.3",
    "typescript": "6.0.3",
    "vitest": "5.0.3"
  },
  "peerDependencies": {
    "expo-network": "^57.0.2",
    "react-native": "^0.86.3"
  },
  "peerDependenciesMeta": {
    "expo-network": {
      "optional": true
    },
    "react-native": {
      "optional": true
    }
  }
}
