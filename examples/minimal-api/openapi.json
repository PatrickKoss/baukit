{
  "components": {
    "schemas": {
      "CreateNote": {
        "description": "Request body accepted by `POST /notes`.",
        "properties": {
          "body": {
            "description": "Free-form note body, limited to 1,000 characters in this example.",
            "type": "string"
          },
          "title": {
            "description": "Short, non-empty note title.",
            "type": "string"
          }
        },
        "required": [
          "title",
          "body"
        ],
        "type": "object"
      },
      "ErrorBody": {
        "description": "The error body nested inside [`ErrorEnvelope`].",
        "properties": {
          "code": {
            "description": "Stable, machine-readable error code.",
            "type": "string"
          },
          "details": {
            "additionalProperties": {},
            "description": "Structured product- or validation-specific error details.",
            "propertyNames": {
              "type": "string"
            },
            "type": "object"
          },
          "message": {
            "description": "Safe user-facing or intentionally generic message.",
            "type": "string"
          },
          "request_id": {
            "description": "Request identifier shared with logs and support tooling.",
            "type": "string"
          }
        },
        "required": [
          "code",
          "message",
          "request_id",
          "details"
        ],
        "type": "object"
      },
      "ErrorEnvelope": {
        "description": "The shared public error response envelope.\n\nThis type deliberately has no HTTP-framework dependency so runtime crates can serialize and\nreuse it directly.",
        "properties": {
          "error": {
            "$ref": "#/components/schemas/ErrorBody",
            "description": "The structured public error."
          }
        },
        "required": [
          "error"
        ],
        "type": "object"
      },
      "Note": {
        "description": "One in-memory note returned by the API.",
        "properties": {
          "body": {
            "description": "Free-form note body.",
            "type": "string"
          },
          "id": {
            "description": "Process-local note identifier.",
            "format": "int64",
            "minimum": 0,
            "type": "integer"
          },
          "title": {
            "description": "Short note title.",
            "type": "string"
          }
        },
        "required": [
          "id",
          "title",
          "body"
        ],
        "type": "object"
      }
    }
  },
  "info": {
    "description": "A dependency-light reference service showing Baukit composition.",
    "license": {
      "name": ""
    },
    "title": "Minimal Notes API",
    "version": "0.1.0"
  },
  "openapi": "3.1.0",
  "paths": {
    "/fail": {
      "get": {
        "operationId": "fail_validation",
        "responses": {
          "400": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            },
            "description": "Deliberate structured validation failure"
          }
        },
        "tags": [
          "example"
        ]
      }
    },
    "/notes": {
      "get": {
        "operationId": "list_notes",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "items": {
                    "$ref": "#/components/schemas/Note"
                  },
                  "type": "array"
                }
              }
            },
            "description": "All notes"
          }
        },
        "tags": [
          "notes"
        ]
      },
      "post": {
        "operationId": "create_note",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CreateNote"
              }
            }
          },
          "required": true
        },
        "responses": {
          "201": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Note"
                }
              }
            },
            "description": "Note created"
          },
          "400": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            },
            "description": "Validation failure"
          },
          "409": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            },
            "description": "Configured note capacity reached"
          }
        },
        "tags": [
          "notes"
        ]
      }
    },
    "/notes/{id}": {
      "get": {
        "operationId": "get_note",
        "parameters": [
          {
            "description": "Process-local note identifier",
            "in": "path",
            "name": "id",
            "required": true,
            "schema": {
              "format": "int64",
              "minimum": 0,
              "type": "integer"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Note"
                }
              }
            },
            "description": "Note found"
          },
          "404": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            },
            "description": "Note not found"
          }
        },
        "tags": [
          "notes"
        ]
      }
    }
  },
  "servers": [
    {
      "url": "/"
    }
  ],
  "tags": [
    {
      "description": "In-memory note operations",
      "name": "notes"
    },
    {
      "description": "Explicit error-contract demonstration",
      "name": "example"
    }
  ]
}
