{
  "name": "{{ context.app_name }}-mobile",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "expo-router/entry",
  "scripts": {
    "start": "pnpm run tokens && expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "tokens": "node scripts/generate-tokens.mjs",
    "typecheck": "tsc --noEmit",
    "lint": "eslint app app.config.ts src --max-warnings=0",
    "test": "jest --runInBand",
    "test:coverage": "jest --runInBand --coverage"
  },
  "dependencies": {
{{ context.baukit_mobile_typescript_dependencies }},
    "@react-native-async-storage/async-storage": "2.2.0",
    "expo": "57.0.11",
    "expo-constants": "catalog:",
    "expo-crypto": "57.0.1",
    "expo-linking": "57.0.7",
    "expo-localization": "57.0.1",
    "expo-router": "57.0.15",
    "expo-sqlite": "57.0.1",
    "i18next": "26.4.0",
    "react": "19.2.8",
    "react-i18next": "17.0.12",
    "react-native": "0.86.2",
    "react-native-gesture-handler": "2.32.0",
    "react-native-reanimated": "4.5.1",
    "react-native-safe-area-context": "5.7.0",
    "react-native-screens": "4.26.2",
    "react-native-worklets": "0.10.1"
  },
  "devDependencies": {
    "@eslint/compat": "2.1.0",
    "@eslint/js": "9.39.5",
    "@jest/globals": "29.7.0",
    "@types/node": "26.2.0",
    "@types/jest": "30.0.0",
    "@types/react": "19.2.18",
    "eslint": "9.39.5",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-react-native-a11y": "3.5.1",
    "globals": "17.9.0",
    "typescript": "6.0.3",
    "typescript-eslint": "8.66.0",
    "jest": "29.7.0",
    "jest-expo": "57.0.3"
  },
  "engines": {
    "node": ">=24.0.0"
  },
  "expo": {
    "install": {
      "exclude": [
        "@types/jest",
        "expo",
        "expo-constants",
        "expo-crypto",
        "expo-linking",
        "expo-router",
        "expo-sqlite",
        "jest-expo",
        "react",
        "react-native"
      ]
    }
  },
  "packageManager": "pnpm@11.18.0"
}
