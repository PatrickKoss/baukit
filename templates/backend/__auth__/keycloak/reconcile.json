{
  "environmentClass": "development",
  "serviceAccountRoles": {"{{ context.app_name }}-backend": ["manage-users"]},
  "realmFields": [
    "displayName",
    "enabled",
    "sslRequired",
    "registrationAllowed",
    "loginWithEmailAllowed",
    "loginTheme",
    "passwordPolicy",
    "bruteForceProtected",
    "accessTokenLifespan",
    "offlineSessionIdleTimeout",
    "offlineSessionMaxLifespanEnabled",
    "offlineSessionMaxLifespan"{% if context.mcp %},
    "clientScopes",
    "defaultDefaultClientScopes",
    "defaultOptionalClientScopes"{% endif %}
  ],
  "clients": [
    {
      "clientId": "{{ context.app_name }}-backend",
      "activeOrigins": [],
      "activeRedirectUris": []
    }{% if context.mcp %},
    {
      "clientId": "{{ context.app_name }}-mcp",
      "exactProtocolMappers": true,
      "exactRedirectUris": true,
      "activeOrigins": [],
      "activeRedirectUris": ["http://localhost:18888/callback", "http://127.0.0.1:18888/callback", "https://claude.ai/api/mcp/auth_callback"]
    }{% endif %}{% if context.web or context.pwa %},
    {
      "clientId": "{{ context.app_name }}-web",
{% if not context.auth_oidc %}      "exactProtocolMappers": true,
{% endif %}      "activeOrigins": [{% for port in context.web_origin_ports %}"http://localhost:{{ port }}"{{ ", " if not loop.last }}{% endfor %}],
      "activeRedirectUris": [{% for port in context.web_origin_ports %}"http://localhost:{{ port }}/*"{{ ", " if not loop.last }}{% endfor %}]
    }{% endif %}{% if context.mobile %},
    {
      "clientId": "{{ context.app_name }}-mobile",
{% if not context.auth_oidc %}      "exactProtocolMappers": true,
{% endif %}      "activeOrigins": [],
      "activeRedirectUris": ["{{ context.app_name }}://oauth"]
    }{% endif %}{% if not context.auth_oidc %},
    {
      "clientId": "{{ context.app_name }}-local",
      "exactProtocolMappers": true,
      "exactRedirectUris": true,
      "activeOrigins": [],
      "activeRedirectUris": ["http://127.0.0.1:{{ context.local_callback_port }}/callback"]
    }{% endif %}
  ],
  "users": ["test"]
}
