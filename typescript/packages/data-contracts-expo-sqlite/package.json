{
  "name": "@baukit/data-contracts-expo-sqlite",
  "version": "0.6.0",
  "description": "Expo SQLite implementation of the @baukit/data-contracts base storage contracts.",
  "license": "MIT",
  "author": "Patrick Koss",
  "homepage": "https://github.com/PatrickKoss/baukit#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/PatrickKoss/baukit.git",
    "directory": "typescript/packages/data-contracts-expo-sqlite"
  },
  "bugs": {
    "url": "https://github.com/PatrickKoss/baukit/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "engines": {
    "node": ">=24.0.0"
  },
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./testing": {
      "types": "./dist/testing.d.ts",
      "import": "./dist/testing.js",
      "default": "./dist/testing.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "prepare": "pnpm run build",
    "test": "tsc -p tsconfig.test.json && vitest run --config ../../vitest.config.ts && node ../../scripts/test-packed-exports.mjs",
    "lint": "eslint src --max-warnings=0",
    "format:check": "prettier --check src package.json tsconfig.json tsconfig.test.json"
  },
  "devDependencies": {
    "@baukit/data-contracts": "workspace:*",
    "@types/node": "26.6.4",
    "expo-sqlite": "57.0.3",
    "typescript": "6.0.3"
  },
  "peerDependencies": {
    "@baukit/data-contracts": "^0.6.0",
    "expo-sqlite": "^57.0.3"
  }
}
