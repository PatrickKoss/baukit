{
  "name": "@baukit/a11y-core",
  "version": "0.2.1",
  "description": "Accessibility behavior shared by web and React Native products: overlay focus, inert background content, announcements, reduced motion, and keyboard movement.",
  "license": "MIT",
  "author": "Patrick Koss",
  "homepage": "https://github.com/PatrickKoss/baukit#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/PatrickKoss/baukit.git",
    "directory": "typescript/packages/a11y-core"
  },
  "bugs": {
    "url": "https://github.com/PatrickKoss/baukit/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "engines": {
    "node": ">=24.0.0"
  },
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./web": {
      "types": "./dist/web.d.ts",
      "import": "./dist/web.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "prepare": "pnpm run build",
    "test": "vitest run --config ../../vitest.config.ts",
    "lint": "eslint src --max-warnings=0",
    "format:check": "prettier --check src package.json tsconfig.json"
  },
  "devDependencies": {
    "@testing-library/dom": "10.4.1",
    "@testing-library/react": "16.3.2",
    "@types/react": "19.2.18",
    "jsdom": "30.0.1",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-native": "0.86.2",
    "typescript": "6.0.3",
    "vitest": "4.1.10"
  },
  "peerDependencies": {
    "react": "^19.2.0",
    "react-native": "^0.86.2"
  },
  "peerDependenciesMeta": {
    "react-native": {
      "optional": true
    }
  }
}
