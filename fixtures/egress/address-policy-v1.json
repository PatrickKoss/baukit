{
  "version": 1,
  "description": "Address policy for guarded outbound HTTP. Under publicOnly an IPv4 address is allowed when it is outside every blockedIpv4 block, and an IPv6 address is allowed when it is inside allowedIpv6 and outside every blockedIpv6InsideAllowed block. IPv4-mapped addresses and the NAT64 well-known prefix 64:ff9b::/96 are judged by the IPv4 address they carry. allowLoopback also allows 127.0.0.0/8, ::1, IPv4-mapped loopback, and plain http. A lookup is allowed only when it is non-empty and every answer is allowed; allowed IPv4-mapped answers connect as plain IPv4. Destination URLs are parsed with the WHATWG URL rules.",
  "sources": [
    {"registry": "IANA IPv4 Special-Purpose Address Registry", "url": "https://www.iana.org/assignments/iana-ipv4-special-registry/", "updated": "2025-10-09"},
    {"registry": "IANA IPv6 Special-Purpose Address Registry", "url": "https://www.iana.org/assignments/iana-ipv6-special-registry/", "updated": "2025-10-09"},
    {"registry": "IANA IPv6 Global Unicast Address Assignments", "url": "https://www.iana.org/assignments/ipv6-unicast-address-assignments/", "updated": "2025-10-10"},
    {"registry": "IANA IPv6 Address Space", "url": "https://www.iana.org/assignments/ipv6-address-space/", "updated": "2025-10-23"}
  ],
  "blockedIpv4": ["0.0.0.0/8", "10.0.0.0/8", "100.64.0.0/10", "127.0.0.0/8", "169.254.0.0/16", "172.16.0.0/12", "192.0.0.0/24", "192.0.2.0/24", "192.88.99.0/24", "192.168.0.0/16", "198.18.0.0/15", "198.51.100.0/24", "203.0.113.0/24", "224.0.0.0/4", "240.0.0.0/4"],
  "allowedIpv6": "2000::/3",
  "blockedIpv6InsideAllowed": ["2001::/23", "2001:db8::/32", "2002::/16", "3fff::/20"],
  "embeddedIpv4Prefixes": ["::ffff:0:0/96", "64:ff9b::/96"],
  "addressCases": [
    {"name": "ipv4-public", "address": "8.8.8.8", "category": "public", "registry": "not special-purpose", "expected": {"publicOnly": true, "allowLoopback": true}},
    {"name": "ipv4-public-second", "address": "93.184.215.14", "category": "public", "registry": "not special-purpose", "expected": {"publicOnly": true, "allowLoopback": true}},
    {"name": "ipv4-this-host", "address": "0.0.0.0", "category": "this-network", "registry": "0.0.0.0/32 This host on this network [RFC1122]", "expected": {"publicOnly": false, "allowLoopback": false}},
    {"name": "ipv4-this-network", "address": "0.1.2.3", "category": "this-network", "registry": "0.0.0.0/8 This network [RFC791]", "expected": {"publicOnly": false, "allowLoopback": false}},
    {"name": "ipv4-private-10", "address": "10.0.0.1", "category": "private", "registry": "10.0.0.0/8 Private-Use [RFC1918]", "expected": {"publicOnly": false, "allowLoopback": false}},
    {"name": "ipv4-private-172-low", "address": "172.16.0.1", "category": "private", "registry": "172.16.0.0/12 Private-Use [RFC1918]", "expected": {"publicOnly": false, "allowLoopback": false}},
    {"name": "ipv4-private-172-high", "address": "172.31.255.255", "category": "private", "registry": "172.16.0.0/12 Private-Use [RFC1918]", "expected": {"publicOnly": false, "allowLoopback": false}},
    {"name": "ipv4-above-private-172", "address": "172.32.0.1", "category": "public", "registry": "not special-purpose", "expected": {"publicOnly": true, "allowLoopback": true}},
    {"name": "ipv4-private-192-168", "address": "192.168.1.1", "category": "private", "registry": "192.168.0.0/16 Private-Use [RFC1918]", "expected": {"publicOnly": false, "allowLoopback": false}},
    {"name": "ipv4-shared-address-space", "address": "100.64.0.1", "category": "shared-address-space", "registry": "100.64.0.0/10 Shared Address Space [RFC6598]", "expected": {"publicOnly": false, "allowLoopback": false}},
    {"name": "ipv4-shared-address-space-high", "address": "100.127.255.254", "category": "shared-address-space", "registry": "100.64.0.0/10 Shared Address Space [RFC6598]", "expected": {"publicOnly": false, "allowLoopback": false}},
    {"name": "ipv4-loopback", "address": "127.0.0.1", "category": "loopback", "registry": "127.0.0.0/8 Loopback [RFC1122]", "expected": {"publicOnly": false, "allowLoopback": true}},
    {"name": "ipv4-loopback-high", "address": "127.255.255.254", "category": "loopback", "registry": "127.0.0.0/8 Loopback [RFC1122]", "expected": {"publicOnly": false, "allowLoopback": true}},
    {"name": "ipv4-link-local-metadata", "address": "169.254.169.254", "category": "link-local", "registry": "169.254.0.0/16 Link Local [RFC3927]", "expected": {"publicOnly": false, "allowLoopback": false}},
    {"name": "ipv4-ietf-protocol-assignments", "address": "192.0.0.1", "category": "ietf-protocol-assignments", "registry": "192.0.0.0/24 IETF Protocol Assignments [RFC6890]", "expected": {"publicOnly": false, "allowLoopback": false}},
    {"name": "ipv4-pcp-anycast", "address": "192.0.0.9", "category": "ietf-protocol-assignments", "registry": "192.0.0.9/32 Port Control Protocol Anycast [RFC7723], globally reachable but blocked with its /24", "expected": {"publicOnly": false, "allowLoopback": false}},
    {"name": "ipv4-nat64-discovery", "address": "192.0.0.170", "category": "ietf-protocol-assignments", "registry": "192.0.0.170/32 NAT64/DNS64 Discovery [RFC7050]", "expected": {"publicOnly": false, "allowLoopback": false}},
    {"name": "ipv4-documentation-1", "address": "192.0.2.1", "category": "documentation", "registry": "192.0.2.0/24 Documentation (TEST-NET-1) [RFC5737]", "expected": {"publicOnly": false, "allowLoopback": false}},
    {"name": "ipv4-documentation-2", "address": "198.51.100.1", "category": "documentation", "registry": "198.51.100.0/24 Documentation (TEST-NET-2) [RFC5737]", "expected": {"publicOnly": false, "allowLoopback": false}},
    {"name": "ipv4-documentation-3", "address": "203.0.113.1", "category": "documentation", "registry": "203.0.113.0/24 Documentation (TEST-NET-3) [RFC5737]", "expected": {"publicOnly": false, "allowLoopback": false}},
    {"name": "ipv4-6to4-relay-anycast", "address": "192.88.99.1", "category": "deprecated", "registry": "192.88.99.0/24 Deprecated (6to4 Relay Anycast) [RFC7526]", "expected": {"publicOnly": false, "allowLoopback": false}},
    {"name": "ipv4-benchmarking", "address": "198.18.0.1", "category": "benchmarking", "registry": "198.18.0.0/15 Benchmarking [RFC2544]", "expected": {"publicOnly": false, "allowLoopback": false}},
    {"name": "ipv4-benchmarking-high", "address": "198.19.255.254", "category": "benchmarking", "registry": "198.18.0.0/15 Benchmarking [RFC2544]", "expected": {"publicOnly": false, "allowLoopback": false}},
    {"name": "ipv4-as112", "address": "192.31.196.1", "category": "public", "registry": "192.31.196.0/24 AS112-v4 [RFC7535], globally reachable", "expected": {"publicOnly": true, "allowLoopback": true}},
    {"name": "ipv4-multicast", "address": "224.0.0.1", "category": "multicast", "registry": "224.0.0.0/4 Multicast [RFC5771], IANA IPv4 Address Space", "expected": {"publicOnly": false, "allowLoopback": false}},
    {"name": "ipv4-multicast-ssdp", "address": "239.255.255.250", "category": "multicast", "registry": "224.0.0.0/4 Multicast [RFC5771], IANA IPv4 Address Space", "expected": {"publicOnly": false, "allowLoopback": false}},
    {"name": "ipv4-reserved", "address": "240.0.0.1", "category": "reserved", "registry": "240.0.0.0/4 Reserved [RFC1112]", "expected": {"publicOnly": false, "allowLoopback": false}},
    {"name": "ipv4-limited-broadcast", "address": "255.255.255.255", "category": "broadcast", "registry": "255.255.255.255/32 Limited Broadcast [RFC8190]", "expected": {"publicOnly": false, "allowLoopback": false}},
    {"name": "ipv6-public", "address": "2606:4700:4700::1111", "category": "public", "registry": "2000::/3 Global Unicast, not special-purpose", "expected": {"publicOnly": true, "allowLoopback": true}},
    {"name": "ipv6-public-outside-ietf-block", "address": "2001:4860:4860::8888", "category": "public", "registry": "2000::/3 Global Unicast, outside 2001::/23", "expected": {"publicOnly": true, "allowLoopback": true}},
    {"name": "ipv6-as112", "address": "2620:4f:8000::1", "category": "public", "registry": "2620:4f:8000::/48 Direct Delegation AS112 Service [RFC7534], globally reachable", "expected": {"publicOnly": true, "allowLoopback": true}},
    {"name": "ipv6-unspecified", "address": "::", "category": "unspecified", "registry": "::/128 Unspecified Address [RFC4291]", "expected": {"publicOnly": false, "allowLoopback": false}},
    {"name": "ipv6-loopback", "address": "::1", "category": "loopback", "registry": "::1/128 Loopback Address [RFC4291]", "expected": {"publicOnly": false, "allowLoopback": true}},
    {"name": "ipv6-ipv4-compatible-loopback", "address": "::127.0.0.1", "category": "deprecated", "registry": "::/96 IPv4-compatible, deprecated by [RFC4291]", "expected": {"publicOnly": false, "allowLoopback": false}},
    {"name": "ipv6-mapped-loopback", "address": "::ffff:127.0.0.1", "category": "ipv4-mapped", "registry": "::ffff:0:0/96 IPv4-mapped Address [RFC4291], carrying 127.0.0.1", "expected": {"publicOnly": false, "allowLoopback": true}},
    {"name": "ipv6-mapped-private", "address": "::ffff:10.0.0.1", "category": "ipv4-mapped", "registry": "::ffff:0:0/96 IPv4-mapped Address [RFC4291], carrying 10.0.0.1", "expected": {"publicOnly": false, "allowLoopback": false}},
    {"name": "ipv6-mapped-metadata", "address": "::ffff:169.254.169.254", "category": "ipv4-mapped", "registry": "::ffff:0:0/96 IPv4-mapped Address [RFC4291], carrying 169.254.169.254", "expected": {"publicOnly": false, "allowLoopback": false}},
    {"name": "ipv6-mapped-public", "address": "::ffff:8.8.8.8", "category": "ipv4-mapped", "registry": "::ffff:0:0/96 IPv4-mapped Address [RFC4291], carrying 8.8.8.8", "expected": {"publicOnly": true, "allowLoopback": true}},
    {"name": "ipv6-nat64-public", "address": "64:ff9b::808:808", "category": "nat64", "registry": "64:ff9b::/96 IPv4-IPv6 Translat. [RFC6052], globally reachable, carrying 8.8.8.8", "expected": {"publicOnly": true, "allowLoopback": true}},
    {"name": "ipv6-nat64-private", "address": "64:ff9b::a00:1", "category": "nat64", "registry": "64:ff9b::/96 IPv4-IPv6 Translat. [RFC6052], carrying 10.0.0.1", "expected": {"publicOnly": false, "allowLoopback": false}},
    {"name": "ipv6-nat64-loopback", "address": "64:ff9b::7f00:1", "category": "nat64", "registry": "64:ff9b::/96 IPv4-IPv6 Translat. [RFC6052], carrying 127.0.0.1 on the translator", "expected": {"publicOnly": false, "allowLoopback": false}},
    {"name": "ipv6-nat64-metadata", "address": "64:ff9b::a9fe:a9fe", "category": "nat64", "registry": "64:ff9b::/96 IPv4-IPv6 Translat. [RFC6052], carrying 169.254.169.254", "expected": {"publicOnly": false, "allowLoopback": false}},
    {"name": "ipv6-nat64-local-use-private", "address": "64:ff9b:1::a00:1", "category": "nat64", "registry": "64:ff9b:1::/48 IPv4-IPv6 Translat. [RFC8215], not globally reachable", "expected": {"publicOnly": false, "allowLoopback": false}},
    {"name": "ipv6-nat64-local-use-public", "address": "64:ff9b:1::808:808", "category": "nat64", "registry": "64:ff9b:1::/48 IPv4-IPv6 Translat. [RFC8215], not globally reachable", "expected": {"publicOnly": false, "allowLoopback": false}},
    {"name": "ipv6-discard-only", "address": "100::1", "category": "discard-only", "registry": "100::/64 Discard-Only Address Block [RFC6666]", "expected": {"publicOnly": false, "allowLoopback": false}},
    {"name": "ipv6-teredo", "address": "2001::1", "category": "ietf-protocol-assignments", "registry": "2001::/32 TEREDO [RFC4380], inside 2001::/23", "expected": {"publicOnly": false, "allowLoopback": false}},
    {"name": "ipv6-pcp-anycast", "address": "2001:1::1", "category": "ietf-protocol-assignments", "registry": "2001:1::1/128 Port Control Protocol Anycast [RFC7723], globally reachable but blocked with 2001::/23", "expected": {"publicOnly": false, "allowLoopback": false}},
    {"name": "ipv6-benchmarking", "address": "2001:2::1", "category": "benchmarking", "registry": "2001:2::/48 Benchmarking [RFC5180]", "expected": {"publicOnly": false, "allowLoopback": false}},
    {"name": "ipv6-orchid-v2", "address": "2001:20::1", "category": "ietf-protocol-assignments", "registry": "2001:20::/28 ORCHIDv2 [RFC7343], globally reachable but blocked with 2001::/23", "expected": {"publicOnly": false, "allowLoopback": false}},
    {"name": "ipv6-ietf-block-end", "address": "2001:1ff:ffff::1", "category": "ietf-protocol-assignments", "registry": "2001::/23 IETF Protocol Assignments [RFC2928]", "expected": {"publicOnly": false, "allowLoopback": false}},
    {"name": "ipv6-after-ietf-block", "address": "2001:200::1", "category": "public", "registry": "2000::/3 Global Unicast, first /23 after 2001::/23", "expected": {"publicOnly": true, "allowLoopback": true}},
    {"name": "ipv6-documentation", "address": "2001:db8::1", "category": "documentation", "registry": "2001:db8::/32 Documentation [RFC3849]", "expected": {"publicOnly": false, "allowLoopback": false}},
    {"name": "ipv6-6to4-private", "address": "2002:a00:1::1", "category": "6to4", "registry": "2002::/16 6to4 [RFC3056], carrying 10.0.0.1", "expected": {"publicOnly": false, "allowLoopback": false}},
    {"name": "ipv6-6to4-public", "address": "2002:808:808::1", "category": "6to4", "registry": "2002::/16 6to4 [RFC3056], blocked whatever it carries", "expected": {"publicOnly": false, "allowLoopback": false}},
    {"name": "ipv6-documentation-3fff", "address": "3fff::1", "category": "documentation", "registry": "3fff::/20 Documentation [RFC9637]", "expected": {"publicOnly": false, "allowLoopback": false}},
    {"name": "ipv6-documentation-3fff-end", "address": "3fff:fff:ffff::1", "category": "documentation", "registry": "3fff::/20 Documentation [RFC9637], last /32 of the block", "expected": {"publicOnly": false, "allowLoopback": false}},
    {"name": "ipv6-after-documentation-3fff", "address": "3fff:1000::1", "category": "public", "registry": "2000::/3 Global Unicast, first address after 3fff::/20, not special-purpose", "expected": {"publicOnly": true, "allowLoopback": true}},
    {"name": "ipv6-3fff-high", "address": "3fff:ffff::1", "category": "public", "registry": "2000::/3 Global Unicast, inside 3fff::/16 but outside 3fff::/20", "expected": {"publicOnly": true, "allowLoopback": true}},
    {"name": "ipv6-former-6bone", "address": "3ffe::1", "category": "public", "registry": "3ffe::/16 IANA reserved global unicast; allocation status is not checked", "expected": {"publicOnly": true, "allowLoopback": true}},
    {"name": "ipv6-srv6-sids", "address": "5f00::1", "category": "segment-routing", "registry": "5f00::/16 Segment Routing (SRv6) SIDs [RFC9602]", "expected": {"publicOnly": false, "allowLoopback": false}},
    {"name": "ipv6-unique-local-fc", "address": "fc00::1", "category": "unique-local", "registry": "fc00::/7 Unique-Local [RFC4193]", "expected": {"publicOnly": false, "allowLoopback": false}},
    {"name": "ipv6-unique-local-fd", "address": "fd12:3456::1", "category": "unique-local", "registry": "fc00::/7 Unique-Local [RFC4193]", "expected": {"publicOnly": false, "allowLoopback": false}},
    {"name": "ipv6-link-local", "address": "fe80::1", "category": "link-local", "registry": "fe80::/10 Link-Local Unicast [RFC4291]", "expected": {"publicOnly": false, "allowLoopback": false}},
    {"name": "ipv6-site-local", "address": "fec0::1", "category": "deprecated", "registry": "fec0::/10 site-local, deprecated by [RFC3879]", "expected": {"publicOnly": false, "allowLoopback": false}},
    {"name": "ipv6-multicast", "address": "ff02::1", "category": "multicast", "registry": "ff00::/8 Multicast [RFC4291], IANA IPv6 Address Space", "expected": {"publicOnly": false, "allowLoopback": false}}
  ],
  "destinationCases": [
    {"name": "https-host-name", "url": "https://hooks.example.com/deliver?token=query-secret", "expected": {"publicOnly": {"outcome": "accepted"}, "allowLoopback": {"outcome": "accepted"}}},
    {"name": "plain-http-host-name", "url": "http://hooks.example.com/deliver", "expected": {"publicOnly": {"outcome": "destination_not_allowed", "reason": "scheme"}, "allowLoopback": {"outcome": "accepted"}}},
    {"name": "other-scheme", "url": "ftp://hooks.example.com/deliver", "expected": {"publicOnly": {"outcome": "destination_not_allowed", "reason": "scheme"}, "allowLoopback": {"outcome": "destination_not_allowed", "reason": "scheme"}}},
    {"name": "file-scheme", "url": "file:///etc/passwd", "expected": {"publicOnly": {"outcome": "destination_not_allowed", "reason": "scheme"}, "allowLoopback": {"outcome": "destination_not_allowed", "reason": "scheme"}}},
    {"name": "user-and-password", "url": "https://user:url-secret@hooks.example.com/deliver", "expected": {"publicOnly": {"outcome": "destination_not_allowed", "reason": "credentials"}, "allowLoopback": {"outcome": "destination_not_allowed", "reason": "credentials"}}},
    {"name": "password-only", "url": "https://:url-secret@hooks.example.com/deliver", "expected": {"publicOnly": {"outcome": "destination_not_allowed", "reason": "credentials"}, "allowLoopback": {"outcome": "destination_not_allowed", "reason": "credentials"}}},
    {"name": "fragment", "url": "https://hooks.example.com/deliver#section", "expected": {"publicOnly": {"outcome": "destination_not_allowed", "reason": "fragment"}, "allowLoopback": {"outcome": "destination_not_allowed", "reason": "fragment"}}},
    {"name": "public-ipv4-literal", "url": "https://8.8.8.8/deliver", "expected": {"publicOnly": {"outcome": "accepted"}, "allowLoopback": {"outcome": "accepted"}}},
    {"name": "private-ipv4-literal", "url": "https://10.0.0.1/deliver", "expected": {"publicOnly": {"outcome": "blocked_address"}, "allowLoopback": {"outcome": "blocked_address"}}},
    {"name": "loopback-ipv4-literal", "url": "https://127.0.0.1:8443/deliver", "expected": {"publicOnly": {"outcome": "blocked_address"}, "allowLoopback": {"outcome": "accepted"}}},
    {"name": "decimal-ipv4-literal", "url": "https://2130706433/deliver", "expected": {"publicOnly": {"outcome": "blocked_address"}, "allowLoopback": {"outcome": "accepted"}}},
    {"name": "hex-ipv4-literal", "url": "https://0x7f.1/deliver", "expected": {"publicOnly": {"outcome": "blocked_address"}, "allowLoopback": {"outcome": "accepted"}}},
    {"name": "metadata-ipv4-literal", "url": "http://169.254.169.254/latest/meta-data", "expected": {"publicOnly": {"outcome": "destination_not_allowed", "reason": "scheme"}, "allowLoopback": {"outcome": "blocked_address"}}},
    {"name": "mapped-private-literal", "url": "https://[::ffff:a00:1]/deliver", "expected": {"publicOnly": {"outcome": "blocked_address"}, "allowLoopback": {"outcome": "blocked_address"}}},
    {"name": "nat64-metadata-literal", "url": "https://[64:ff9b::a9fe:a9fe]/deliver", "expected": {"publicOnly": {"outcome": "blocked_address"}, "allowLoopback": {"outcome": "blocked_address"}}},
    {"name": "public-ipv6-literal", "url": "https://[3fff:1000::1]/deliver", "expected": {"publicOnly": {"outcome": "accepted"}, "allowLoopback": {"outcome": "accepted"}}},
    {"name": "documentation-ipv6-literal", "url": "https://[3fff::1]/deliver", "expected": {"publicOnly": {"outcome": "blocked_address"}, "allowLoopback": {"outcome": "blocked_address"}}},
    {"name": "localhost-name", "url": "https://localhost/deliver", "expected": {"publicOnly": {"outcome": "accepted"}, "allowLoopback": {"outcome": "accepted"}}}
  ],
  "resolutionCases": [
    {"name": "public-dual-stack", "policy": "publicOnly", "answers": [["93.184.215.14", "2606:4700:4700::1111"]], "expected": [{"outcome": "connect", "addresses": ["93.184.215.14", "2606:4700:4700::1111"]}]},
    {"name": "private-answer", "policy": "publicOnly", "answers": [["10.0.0.1"]], "expected": [{"outcome": "blocked_address"}]},
    {"name": "mixed-public-then-private", "policy": "publicOnly", "answers": [["93.184.215.14", "10.0.0.1"]], "expected": [{"outcome": "blocked_address"}], "note": "One disallowed answer rejects the whole lookup."},
    {"name": "mixed-private-then-public", "policy": "publicOnly", "answers": [["10.0.0.1", "93.184.215.14"]], "expected": [{"outcome": "blocked_address"}]},
    {"name": "mixed-private-last-of-three", "policy": "publicOnly", "answers": [["8.8.8.8", "1.1.1.1", "192.168.0.1"]], "expected": [{"outcome": "blocked_address"}], "note": "Every answer is checked, not only the first."},
    {"name": "mixed-public-and-link-local-v6", "policy": "publicOnly", "answers": [["2606:4700:4700::1111", "fe80::1"]], "expected": [{"outcome": "blocked_address"}]},
    {"name": "mixed-public-and-mapped-loopback", "policy": "publicOnly", "answers": [["8.8.8.8", "::ffff:127.0.0.1"]], "expected": [{"outcome": "blocked_address"}]},
    {"name": "mixed-public-and-mapped-loopback-in-development", "policy": "allowLoopback", "answers": [["8.8.8.8", "::ffff:127.0.0.1"]], "expected": [{"outcome": "connect", "addresses": ["8.8.8.8", "127.0.0.1"]}], "note": "IPv4-mapped answers connect as plain IPv4."},
    {"name": "loopback-mixed-with-private-in-development", "policy": "allowLoopback", "answers": [["127.0.0.1", "10.0.0.1"]], "expected": [{"outcome": "blocked_address"}]},
    {"name": "mapped-public-canonicalized", "policy": "publicOnly", "answers": [["::ffff:8.8.8.8"]], "expected": [{"outcome": "connect", "addresses": ["8.8.8.8"]}]},
    {"name": "nat64-synthesized-public", "policy": "publicOnly", "answers": [["64:ff9b::5db8:d70e"]], "expected": [{"outcome": "connect", "addresses": ["64:ff9b::5db8:d70e"]}], "note": "DNS64 synthesis of 93.184.215.14 stays reachable through the translator."},
    {"name": "nat64-synthesized-private", "policy": "publicOnly", "answers": [["64:ff9b::a00:1"]], "expected": [{"outcome": "blocked_address"}]},
    {"name": "empty-answer", "policy": "publicOnly", "answers": [[]], "expected": [{"outcome": "resolve_failed"}]},
    {"name": "answer-changes-between-validation-and-connect", "policy": "publicOnly", "answers": [["93.184.215.14"], ["10.0.0.1"]], "expected": [{"outcome": "connect", "addresses": ["93.184.215.14"]}, {"outcome": "blocked_address"}], "note": "Each lookup is checked on its own, and a connection uses only the answers of the lookup it checked. The later private answer never reaches a connection."}
  ]
}
