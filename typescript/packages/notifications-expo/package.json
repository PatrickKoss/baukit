{
  "name": "@baukit/notifications-expo",
  "version": "0.5.2",
  "description": "Optional expo-notifications adapter for @baukit/notifications-core that replaces only notifications carrying one owner's namespace marker.",
  "license": "MIT",
  "author": "Patrick Koss",
  "homepage": "https://github.com/PatrickKoss/baukit#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/PatrickKoss/baukit.git",
    "directory": "typescript/packages/notifications-expo"
  },
  "bugs": {
    "url": "https://github.com/PatrickKoss/baukit/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "engines": {
    "node": ">=24.0.0"
  },
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "prepare": "pnpm run build",
    "test": "tsc -p tsconfig.test.json && vitest run --config ../../vitest.config.ts && node ../../scripts/test-packed-exports.mjs",
    "lint": "eslint src --max-warnings=0",
    "format:check": "prettier --check src package.json tsconfig.json tsconfig.test.json"
  },
  "devDependencies": {
    "@baukit/localization-core": "workspace:*",
    "@baukit/notifications-core": "workspace:*",
    "expo-notifications": "57.0.21",
    "typescript": "6.0.3",
    "vitest": "5.0.3"
  },
  "peerDependencies": {
    "@baukit/notifications-core": "^0.5.2",
    "expo-notifications": "^57.0.21"
  }
}
