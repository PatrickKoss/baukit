{
  "name": "@baukit/analytics-posthog-web",
  "version": "0.6.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.0.0"
  },
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "prepare": "pnpm --dir ../analytics-core run build && pnpm run build",
    "test": "vitest run --config ../../vitest.config.ts",
    "lint": "eslint src --max-warnings=0",
    "format:check": "prettier --check src package.json tsconfig.json"
  },
  "devDependencies": {
    "@baukit/analytics-core": "file:../analytics-core",
    "posthog-js": "1.414.0",
    "typescript": "6.0.3"
  },
  "peerDependencies": {
    "@baukit/analytics-core": "^0.6.0",
    "posthog-js": ">=1.43.1 <2"
  }
}
