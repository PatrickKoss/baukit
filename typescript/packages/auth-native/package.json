{
  "name": "@baukit/auth-native",
  "version": "0.10.7",
  "description": "Provider-neutral native OIDC authorization-code client with S256 PKCE, secure-storage and browser-flow ports, and refresh rotation.",
  "license": "MIT",
  "author": "Patrick Koss",
  "homepage": "https://github.com/PatrickKoss/baukit#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/PatrickKoss/baukit.git",
    "directory": "typescript/packages/auth-native"
  },
  "bugs": {
    "url": "https://github.com/PatrickKoss/baukit/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "engines": {
    "node": ">=24.0.0"
  },
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./expo": {
      "types": "./dist/expo.d.ts",
      "import": "./dist/expo.js",
      "default": "./dist/expo.js"
    },
    "./clerk": {
      "types": "./dist/clerk.d.ts",
      "import": "./dist/clerk.js",
      "default": "./dist/clerk.js"
    },
    "./clerk-expo": {
      "types": "./dist/clerk-expo.d.ts",
      "import": "./dist/clerk-expo.js",
      "default": "./dist/clerk-expo.js"
    },
    "./workos": {
      "types": "./dist/workos.d.ts",
      "import": "./dist/workos.js",
      "default": "./dist/workos.js"
    }
  },
  "files": [
    "dist",
    "src",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "prepare": "pnpm run build",
    "test": "tsc -p tsconfig.test.json && vitest run --config ../../vitest.config.ts && node ../../scripts/test-packed-exports.mjs",
    "lint": "eslint src --max-warnings=0",
    "format:check": "prettier --check src package.json tsconfig.json tsconfig.test.json"
  },
  "devDependencies": {
    "expo-auth-session": "57.0.13",
    "expo-secure-store": "57.0.4",
    "expo-web-browser": "57.0.3",
    "typescript": "6.0.3",
    "@clerk/expo": "4.8.1",
    "react": "19.3.0",
    "@types/react": "19.3.0"
  },
  "peerDependencies": {
    "expo-auth-session": "^57.0.13",
    "expo-secure-store": "^57.0.4",
    "expo-web-browser": "^57.0.3",
    "@clerk/expo": "^4.8.1",
    "react": "^19.2.3"
  },
  "peerDependenciesMeta": {
    "@clerk/expo": {
      "optional": true
    },
    "react": {
      "optional": true
    }
  }
}
