[workspace]
resolver = "2"
members = [
  "crates/{{ context.app_name }}-domain",
  "crates/{{ context.app_name }}-ports",
  "crates/{{ context.app_name }}-services",
  "crates/{{ context.app_name }}-api",
  "crates/{{ context.app_name }}-postgres",
  "crates/{{ context.app_name }}-bin",
{% if context.mcp %}  "crates/{{ context.app_name }}-mcp",
{% endif %}{% if context.worker %}  "crates/{{ context.app_name }}-worker",
{% endif %}]
exclude = ["fuzz"]

[workspace.package]
version = "0.1.0"
edition = "2024"
rust-version = "1.95"
publish = false

[workspace.dependencies]
axum = "0.8.9"
{% if context.auth_enabled or context.platform %}chrono = "0.4.45"
{% endif %}{{ context.baukit_dependencies }}
{% if context.platform %}async-trait = "0.1.89"
url = "2.5.8"
{% endif %}serde = { version = "1.0.229", features = ["derive"] }
serde_json = "1.0.151"
sqlx = { version = "0.9.0", default-features = false, features = ["runtime-tokio", "tls-rustls-aws-lc-rs", "postgres", "uuid", "migrate"] }
thiserror = "2.0.21"
tokio = { version = "1.53.2", features = ["full"] }
tower = { version = "0.5.3", features = ["util"] }
utoipa = { version = "6.0.0", features = ["uuid"] }
uuid = { version = "1.27.0", features = ["v4", "v7", "serde"] }

{{ context.app_crate }}-domain = { path = "crates/{{ context.app_name }}-domain" }
{{ context.app_crate }}-ports = { path = "crates/{{ context.app_name }}-ports" }
{{ context.app_crate }}-services = { path = "crates/{{ context.app_name }}-services" }
{{ context.app_crate }}-api = { path = "crates/{{ context.app_name }}-api" }
{{ context.app_crate }}-postgres = { path = "crates/{{ context.app_name }}-postgres" }
{% if context.worker %}{{ context.app_crate }}-worker = { path = "crates/{{ context.app_name }}-worker" }
{% endif %}{% if context.mcp %}{{ context.app_crate }}-mcp = { path = "crates/{{ context.app_name }}-mcp" }
{% endif %}

[workspace.lints.rust]
unsafe_code = "deny"

[workspace.lints.clippy]
all = { level = "warn", priority = -1 }
dbg_macro = "warn"
todo = "warn"
unimplemented = "warn"
unwrap_used = "warn"
expect_used = "warn"
panic = "warn"
indexing_slicing = "warn"
cast_possible_truncation = "warn"
cast_sign_loss = "warn"
cast_possible_wrap = "warn"
cast_precision_loss = "warn"
too_many_lines = "warn"
allow_attributes_without_reason = "warn"
missing_panics_doc = "warn"
return_self_not_must_use = "warn"
unused_async = "warn"
needless_pass_by_value = "warn"
manual_let_else = "warn"
struct_excessive_bools = "warn"
fn_params_excessive_bools = "warn"
print_stdout = "warn"
print_stderr = "warn"
