{
  "name": "{{ context.app_name }}-mobile",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "expo-router/entry",
  "scripts": {
    "setup": "sh ../scripts/setup.sh",
    "start": "pnpm run tokens && expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "tokens": "node scripts/generate-tokens.mjs",
    "typecheck": "tsc --noEmit",
    "lint": "eslint app app.config.ts src --max-warnings=0",
    "test": "jest --runInBand",
    "test:coverage": "jest --runInBand --coverage"
  },
  "dependencies": {
{{ context.baukit_mobile_typescript_dependencies }},
    "@react-native-async-storage/async-storage": "2.2.0",
    "expo": "57.0.26",
    "expo-auth-session": "57.0.13",
    "expo-constants": "catalog:",
    "expo-crypto": "57.0.3",
    "expo-linking": "57.0.11",
    "expo-localization": "57.0.2",
    "expo-router": "57.0.24",
    "expo-sqlite": "57.0.3",
    "expo-secure-store": "57.0.4",
    "expo-web-browser": "57.0.3",
    "i18next": "26.4.2",
    "react": "19.2.8",
    "react-i18next": "17.0.15",
    "react-native": "0.86.3",
    "react-native-gesture-handler": "2.32.0",
    "react-native-reanimated": "4.5.1",
    "react-native-safe-area-context": "5.7.0",
    "react-native-screens": "4.26.2",
    "react-native-worklets": "0.10.1"
  },
  "devDependencies": {
    "@eslint/compat": "2.1.1",
    "@eslint/js": "10.0.1",
    "@jest/globals": "29.7.0",
    "@testing-library/react-native": "14.0.1",
    "@types/node": "26.6.4",
    "@types/jest": "29.5.14",
    "@types/react": "19.2.18",
    "eslint": "10.12.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-react-native-a11y": "3.5.1",
    "globals": "17.13.0",
    "typescript": "6.0.3",
    "typescript-eslint": "8.71.0",
    "jest": "29.7.0",
    "jest-expo": "57.0.5",
    "test-renderer": "1.2.0"
  },
  "engines": {
    "node": ">=24.0.0"
  },
  "expo": {
    "install": {
      "exclude": [
        "@types/jest",
        "expo",
        "expo-constants",
        "expo-crypto",
        "expo-linking",
        "expo-router",
        "expo-sqlite",
        "jest-expo",
        "react",
        "react-native"
      ]
    }
  },
  "packageManager": "pnpm@12.9.1"
}
