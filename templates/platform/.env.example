# Backend runtime settings. Omitting hub settings selects free standalone entitlements.
{{ context.app_env }}__DATABASE__URL=postgres://postgres:postgres@localhost:{{ context.postgres_host_port }}/{{ context.app_crate }}
{{ context.app_env }}__PLATFORM__PRODUCT_ID={{ context.app_crate }}
{{ context.app_env }}__PLATFORM__STANDALONE_DEFAULT__TIER=free
{{ context.app_env }}__PLATFORM__STANDALONE_DEFAULT__FEATURES=[]
# Set all hub settings together. Receiver secrets and service tokens stay server-side.
# {{ context.app_env }}__PLATFORM__HUB_ISSUER=https://hub.example
# {{ context.app_env }}__PLATFORM__JWKS_URL=https://hub.example/keys.json
# {{ context.app_env }}__PLATFORM__SOURCE_APP=identity_hub
# {{ context.app_env }}__PLATFORM__EVENT_TYPE_PREFIX=identity_hub
# {{ context.app_env }}__PLATFORM__RECEIVER_SECRET=replace-through-secret-manager
# {{ context.app_env }}__PLATFORM__PREVIOUS_RECEIVER_SECRET=previous-during-rotation
# {{ context.app_env }}__PLATFORM_HUB__TICKET_URL=https://hub.example/platform/v1/entitlements/tickets
# {{ context.app_env }}__PLATFORM_HUB__SERVICE_TOKEN=replace-through-secret-manager
# {{ context.app_env }}__PLATFORM_HUB__ALLOW_LOCAL_HTTP=false
