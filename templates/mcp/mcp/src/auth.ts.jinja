import { resolve } from 'node:path';
import { pathToFileURL } from 'node:url';

export type BearerTokenProvider = () => string | Promise<string>;

export function personalTokenProvider(
  environment: Readonly<Record<string, string | undefined>> = process.env,
): BearerTokenProvider {
  return () => environment['{{ context.app_env }}_API_TOKEN']?.trim() ?? '';
}

export function callerSuppliedProvider(
  modulePath: string,
): BearerTokenProvider {
  let loaded: Promise<BearerTokenProvider> | undefined;
  return async () => {
    loaded ??= import(pathToFileURL(resolve(modulePath)).href).then(
      (module: unknown) => {
        if (
          typeof module !== 'object' ||
          module === null ||
          !('bearerToken' in module) ||
          typeof module.bearerToken !== 'function'
        ) {
          throw new Error('The provider module must export bearerToken.');
        }
        return module.bearerToken as BearerTokenProvider;
      },
    );
    return (await loaded)();
  };
}{% if context.mcp_auth_node_oidc %}

import { DeviceFlowClient } from '@baukit/auth-node/device-flow';

export interface NodeOidcProviderOptions {
  readonly environment?: Readonly<Record<string, string | undefined>>;
}

export function nodeOidcProvider(options: NodeOidcProviderOptions = {}): {
  readonly bearerToken: BearerTokenProvider;
  readonly login: () => Promise<void>;
  readonly logout: () => Promise<boolean>;
} {
  const environment = options.environment ?? process.env;
  const client = new DeviceFlowClient(
    {
      issuer:
        environment['{{ context.app_env }}_OIDC_ISSUER']?.trim() ??
        'http://localhost:{{ context.keycloak_host_port }}/realms/{{ context.app_name }}',
      clientId: environment['{{ context.app_env }}_OIDC_CLIENT_ID']?.trim() ?? '{{ context.app_name }}-mcp',
      scopes: ['openid', 'profile', 'offline_access'],
      cache: { namespace: '{{ context.app_name }}-mcp' },
      endpointPolicy: {
        allowLoopbackHttp: environment['NODE_ENV'] !== 'production',
      },
    },
    {
      environmentToken: () => environment['{{ context.app_env }}_API_TOKEN'],
    },
  );
  return {
    bearerToken: () => client.accessToken(),
    login: async () => {
      await client.login({
        presentation: {
          showVerification: ({ verificationUri, userCode }) => {
            process.stderr.write(
              `Open ${verificationUri}\nEnter ${userCode}\n`,
            );
          },
          showStatus: (status) => {
            process.stderr.write(`Login status: ${status}\n`);
          },
        },
      });
    },
    logout: () => client.logout(),
  };
}{% endif %}
