{
  "name": "{{ context.app_name }}-mobile",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "expo/AppEntry.js",
  "scripts": {
    "start": "pnpm run tokens && expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "tokens": "node scripts/generate-tokens.mjs",
    "typecheck": "tsc --noEmit",
    "lint": "eslint App.tsx app.config.ts src --max-warnings=0",
    "test": "vitest run"
  },
  "dependencies": {
{{ context.baukit_typescript_dependencies }},
    "@react-native-async-storage/async-storage": "2.2.0",
    "expo": "57.0.11",
    "expo-auth-session": "57.0.6",
    "expo-constants": "57.0.9",
    "expo-crypto": "57.0.1",
    "expo-secure-store": "57.0.1",
    "expo-web-browser": "57.0.2",
    "react": "19.2.8",
    "react-native": "0.86.2"
  },
  "devDependencies": {
    "@eslint/js": "9.39.5",
    "@types/node": "26.2.0",
    "@types/react": "19.2.18",
    "eslint": "9.39.5",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "17.9.0",
    "typescript": "6.0.3",
    "typescript-eslint": "8.66.0",
    "vitest": "4.1.10"
  },
  "engines": { "node": ">=24.0.0" },
  "packageManager": "pnpm@11.18.0"
}
