{
  "name": "@baukit/data-contracts-dexie",
  "version": "0.7.0",
  "description": "Dexie 4.x implementation of @baukit/data-contracts for web applications.",
  "license": "MIT",
  "author": "Patrick Koss",
  "homepage": "https://github.com/PatrickKoss/baukit#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/PatrickKoss/baukit.git",
    "directory": "typescript/packages/data-contracts-dexie"
  },
  "bugs": {
    "url": "https://github.com/PatrickKoss/baukit/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "engines": {
    "node": ">=24.0.0"
  },
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "prepare": "pnpm run build",
    "test": "tsc -p tsconfig.test.json && vitest run --config ../../vitest.config.ts --exclude 'src/**/*.browser.test.ts' && node ../../scripts/test-packed-exports.mjs",
    "test:browser": "tsc -p tsconfig.browser.json && vitest run --config vitest.browser.config.ts",
    "check": "pnpm run build && pnpm run lint && pnpm run test && pnpm run format:check && pnpm run test:browser",
    "lint": "eslint src --max-warnings=0",
    "format:check": "prettier --check src package.json tsconfig.json tsconfig.test.json tsconfig.browser.json vitest.browser.config.ts"
  },
  "devDependencies": {
    "@baukit/data-contracts": "workspace:*",
    "@vitest/browser-playwright": "5.0.3",
    "dexie": "4.4.6",
    "fake-indexeddb": "6.2.5",
    "playwright": "1.63.0",
    "typescript": "6.0.3",
    "vitest": "5.0.3"
  },
  "peerDependencies": {
    "@baukit/data-contracts": "^0.7.0",
    "dexie": "^4.4.6"
  }
}
