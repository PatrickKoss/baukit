{
  "name": "@baukit/suite-client",
  "version": "0.10.2",
  "description": "Headless suite linking, authorization state and connected app clients.",
  "license": "MIT",
  "author": "Patrick Koss",
  "homepage": "https://github.com/PatrickKoss/baukit#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/PatrickKoss/baukit.git",
    "directory": "typescript/packages/suite-client"
  },
  "bugs": {
    "url": "https://github.com/PatrickKoss/baukit/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "engines": {
    "node": ">=24.0.0"
  },
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./peers": {
      "import": {
        "types": "./dist/peers.d.ts",
        "default": "./dist/peers.js"
      },
      "require": {
        "types": "./dist/cjs/peers.d.ts",
        "default": "./dist/cjs/peers.js"
      }
    }
  },
  "files": [
    "dist",
    "src",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json && tsc -p tsconfig.cjs.json && node scripts/build-cjs.mjs",
    "prepare": "pnpm run build",
    "test": "tsc -p tsconfig.test.json && vitest run --config ../../vitest.config.ts --maxWorkers=4 && node --test scripts/peers.test.cjs && node ../../scripts/test-packed-exports.mjs --load ./peers",
    "lint": "eslint src --max-warnings=0",
    "format:check": "prettier --check src scripts package.json turbo.json tsconfig.json tsconfig.test.json tsconfig.cjs.json"
  },
  "devDependencies": {
    "@baukit/integrations-client": "workspace:*",
    "@baukit/localization-core": "workspace:*",
    "@types/node": "26.6.4",
    "typescript": "6.0.3",
    "vitest": "5.0.3"
  },
  "peerDependencies": {
    "@baukit/integrations-client": "^0.10.2",
    "@baukit/localization-core": "^0.10.2"
  }
}
