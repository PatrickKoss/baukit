{
  "name": "@baukit/auth-node",
  "version": "0.2.1",
  "description": "Node OIDC device authorization with S256 PKCE, refresh rotation, and a locked token cache.",
  "license": "MIT",
  "author": "Patrick Koss",
  "homepage": "https://github.com/PatrickKoss/baukit#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/PatrickKoss/baukit.git",
    "directory": "typescript/packages/auth-node"
  },
  "bugs": {
    "url": "https://github.com/PatrickKoss/baukit/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "engines": {
    "node": ">=24.0.0"
  },
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./device-flow": {
      "types": "./dist/device-flow.d.ts",
      "import": "./dist/device-flow.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "prepare": "pnpm run build",
    "test": "vitest run --config ../../vitest.config.ts",
    "test:conformance": "vitest run --config ../../vitest.config.ts src/conformance.test.ts",
    "test:conformance:keycloak": "pnpm run build && node scripts/keycloak-conformance.mjs",
    "lint": "eslint src --max-warnings=0",
    "format:check": "prettier --check src scripts package.json tsconfig.json"
  },
  "devDependencies": {
    "@playwright/test": "1.62.1",
    "@types/node": "24.10.1",
    "typescript": "6.0.3"
  }
}
