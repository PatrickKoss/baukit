{
  "name": "@baukit/auth-web",
  "version": "0.24.0",
  "description": "Browser sign-in for baukit products: OIDC authorization code with S256 PKCE redeemed by the product backend, a memory-only access token, and cross-tab session coordination.",
  "license": "MIT",
  "author": "Patrick Koss",
  "homepage": "https://github.com/PatrickKoss/baukit#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/PatrickKoss/baukit.git",
    "directory": "typescript/packages/auth-web"
  },
  "bugs": {
    "url": "https://github.com/PatrickKoss/baukit/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "engines": {
    "node": ">=24.0.0"
  },
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./clerk": {
      "types": "./dist/clerk.d.ts",
      "import": "./dist/clerk.js",
      "default": "./dist/clerk.js"
    },
    "./workos": {
      "types": "./dist/workos.d.ts",
      "import": "./dist/workos.js",
      "default": "./dist/workos.js"
    }
  },
  "files": [
    "dist",
    "src",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "prepare": "pnpm run build",
    "test": "tsc -p tsconfig.test.json && vitest run --config ../../vitest.config.ts && node ../../scripts/test-packed-exports.mjs",
    "lint": "eslint . --max-warnings=0",
    "format:check": "prettier --check src package.json tsconfig.json tsconfig.test.json"
  },
  "devDependencies": {
    "@baukit/api-runtime": "workspace:*",
    "@clerk/clerk-js": "6.38.0",
    "@workos-inc/authkit-js": "0.20.4",
    "jsdom": "30.1.1",
    "typescript": "6.0.3"
  },
  "peerDependencies": {
    "@clerk/clerk-js": "^6.38.0",
    "@workos-inc/authkit-js": "^0.20.4"
  },
  "peerDependenciesMeta": {
    "@clerk/clerk-js": {
      "optional": true
    },
    "@workos-inc/authkit-js": {
      "optional": true
    }
  },
  "dependencies": {
    "@baukit/type-guards": "^0.24.0",
    "jose": "6.2.12"
  }
}
