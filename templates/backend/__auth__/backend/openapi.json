{
  "components": {
    "schemas": {
      "CurrentUserDto": {
        "properties": {
          "id": {
            "format": "uuid",
            "type": "string"
          },
          "subject": {
            "type": "string"
          }
        },
        "required": [
          "id",
          "subject"
        ],
        "type": "object"
      },
      "ErrorBody": {
        "description": "The error body nested inside [`ErrorEnvelope`].",
        "properties": {
          "code": {
            "description": "Stable, machine-readable error code.",
            "type": "string"
          },
          "details": {
            "additionalProperties": {},
            "description": "Structured product- or validation-specific error details.",
            "propertyNames": {
              "type": "string"
            },
            "type": "object"
          },
          "message": {
            "description": "Safe user-facing or intentionally generic message.",
            "type": "string"
          },
          "request_id": {
            "description": "Request identifier shared with logs and support tooling.",
            "type": "string"
          }
        },
        "required": [
          "code",
          "message",
          "request_id",
          "details"
        ],
        "type": "object"
      },
      "ErrorEnvelope": {
        "description": "The shared public error response envelope.\n\nThis type deliberately has no HTTP-framework dependency so runtime crates can serialize and\nreuse it directly.",
        "properties": {
          "error": {
            "$ref": "#/components/schemas/ErrorBody",
            "description": "The structured public error."
          }
        },
        "required": [
          "error"
        ],
        "type": "object"
      },
      "ItemDto": {
        "properties": {
          "id": {
            "format": "uuid",
            "type": "string"
          },
          "name": {
            "type": "string"
          }
        },
        "required": [
          "id",
          "name"
        ],
        "type": "object"
      },
      "SaveItemRequest": {
        "properties": {
          "name": {
            "type": "string"
          }
        },
        "required": [
          "name"
        ],
        "type": "object"
      }
    },
    "securitySchemes": {
      "bearerAuth": {
        "bearerFormat": "JWT",
        "description": "OIDC access token supplied as an HTTP bearer JWT.",
        "scheme": "bearer",
        "type": "http"
      }
    }
  },
  "info": {
    "description": "Generated Baukit item service.",
    "license": {
      "name": ""
    },
    "title": "{{ context.app_name }} API",
    "version": "0.1.0"
  },
  "openapi": "3.1.0",
  "paths": {
    "/items": {
      "get": {
        "operationId": "list_items",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "items": {
                    "$ref": "#/components/schemas/ItemDto"
                  },
                  "type": "array"
                }
              }
            },
            "description": "Items"
          }
        },
        "tags": [
          "items"
        ]
      },
      "post": {
        "operationId": "create_item",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/SaveItemRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "201": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ItemDto"
                }
              }
            },
            "description": "Created"
          },
          "400": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            },
            "description": "Invalid request"
          },
          "409": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            },
            "description": "Conflict"
          }
        },
        "tags": [
          "items"
        ]
      }
    },
    "/items/{id}": {
      "delete": {
        "operationId": "delete_item",
        "parameters": [
          {
            "description": "Item identifier",
            "in": "path",
            "name": "id",
            "required": true,
            "schema": {
              "format": "uuid",
              "type": "string"
            }
          }
        ],
        "responses": {
          "204": {
            "description": "Deleted"
          },
          "404": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            },
            "description": "Not found"
          }
        },
        "tags": [
          "items"
        ]
      },
      "get": {
        "operationId": "get_item",
        "parameters": [
          {
            "description": "Item identifier",
            "in": "path",
            "name": "id",
            "required": true,
            "schema": {
              "format": "uuid",
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ItemDto"
                }
              }
            },
            "description": "Item"
          },
          "404": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            },
            "description": "Not found"
          }
        },
        "tags": [
          "items"
        ]
      },
      "put": {
        "operationId": "update_item",
        "parameters": [
          {
            "description": "Item identifier",
            "in": "path",
            "name": "id",
            "required": true,
            "schema": {
              "format": "uuid",
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/SaveItemRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ItemDto"
                }
              }
            },
            "description": "Updated"
          },
          "400": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            },
            "description": "Invalid request"
          },
          "404": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            },
            "description": "Not found"
          }
        },
        "tags": [
          "items"
        ]
      }
    },
    "/me": {
      "get": {
        "operationId": "current_user",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CurrentUserDto"
                }
              }
            },
            "description": "Current internal user"
          },
          "401": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            },
            "description": "Authentication required"
          }
        },
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "tags": [
          "auth"
        ]
      }
    }
  },
  "servers": [
    {
      "url": "/"
    }
  ],
  "tags": [
    {
      "description": "Example item operations",
      "name": "items"
    },
    {
      "description": "Protected identity example",
      "name": "auth"
    }
  ]
}
