{
  "contract_version": 1,
  "representation": {
    "event_id_length": "unicode_scalar_values_1_to_64",
    "event_type": "three_lower_snake_ascii_segments_1_to_32_each",
    "timestamps": "rfc3339_utc_z",
    "payload": "json_object_with_at_most_32_lower_camel_ascii_keys",
    "age_boundary": "event_too_old_when_occurred_at_is_more_than_604800_seconds_before_now",
    "validation_order": [
      "event_schema_unsupported",
      "event_id_invalid",
      "event_type_invalid",
      "event_user_mismatch",
      "event_too_old"
    ]
  },
  "constants": {
    "schema_version": 1,
    "maximum_event_id_characters": 64,
    "maximum_event_type_segment_characters": 32,
    "maximum_event_age_seconds": 604800,
    "maximum_payload_keys": 32
  },
  "cases": [
    {
      "name": "canonical envelope is valid",
      "input": {
        "envelope": {
          "eventId": "0198f3a2-7c1e-7d42-9a31-2b9f0c9a1d77",
          "type": "hebkit.workout.completed",
          "userId": "oidc-subject-1",
          "occurredAt": "2026-08-24T10:00:00Z",
          "sourceApp": "hebkit",
          "schemaVersion": 1,
          "payload": {
            "durationMinutes": 42,
            "workoutId": "0198f3a2-7c1e-7d42-9a31-2b9f0c9a1d78"
          }
        },
        "expected_user_id": "oidc-subject-1",
        "now": "2026-08-24T12:00:00Z"
      },
      "expected_code": null
    },
    {
      "name": "event ID at 64 characters is valid",
      "input": {
        "envelope": {
          "eventId": "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa",
          "type": "focus.session.completed",
          "userId": "oidc-subject-1",
          "occurredAt": "2026-08-24T11:00:00Z",
          "sourceApp": "tiefgang",
          "schemaVersion": 1,
          "payload": {}
        },
        "expected_user_id": "oidc-subject-1",
        "now": "2026-08-24T12:00:00Z"
      },
      "expected_code": null
    },
    {
      "name": "empty event ID is invalid",
      "input": {
        "envelope": {
          "eventId": "",
          "type": "focus.session.completed",
          "userId": "oidc-subject-1",
          "occurredAt": "2026-08-24T11:00:00Z",
          "sourceApp": "tiefgang",
          "schemaVersion": 1,
          "payload": {}
        },
        "expected_user_id": "oidc-subject-1",
        "now": "2026-08-24T12:00:00Z"
      },
      "expected_code": "event_id_invalid"
    },
    {
      "name": "event ID over 64 characters is invalid",
      "input": {
        "envelope": {
          "eventId": "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa",
          "type": "focus.session.completed",
          "userId": "oidc-subject-1",
          "occurredAt": "2026-08-24T11:00:00Z",
          "sourceApp": "tiefgang",
          "schemaVersion": 1,
          "payload": {}
        },
        "expected_user_id": "oidc-subject-1",
        "now": "2026-08-24T12:00:00Z"
      },
      "expected_code": "event_id_invalid"
    },
    {
      "name": "event type needs three segments",
      "input": {
        "envelope": {
          "eventId": "event-type-two-segments",
          "type": "focus.completed",
          "userId": "oidc-subject-1",
          "occurredAt": "2026-08-24T11:00:00Z",
          "sourceApp": "tiefgang",
          "schemaVersion": 1,
          "payload": {}
        },
        "expected_user_id": "oidc-subject-1",
        "now": "2026-08-24T12:00:00Z"
      },
      "expected_code": "event_type_invalid"
    },
    {
      "name": "event type rejects uppercase characters",
      "input": {
        "envelope": {
          "eventId": "event-type-uppercase",
          "type": "Focus.session.completed",
          "userId": "oidc-subject-1",
          "occurredAt": "2026-08-24T11:00:00Z",
          "sourceApp": "tiefgang",
          "schemaVersion": 1,
          "payload": {}
        },
        "expected_user_id": "oidc-subject-1",
        "now": "2026-08-24T12:00:00Z"
      },
      "expected_code": "event_type_invalid"
    },
    {
      "name": "connection subject must match the envelope user",
      "input": {
        "envelope": {
          "eventId": "event-user-mismatch",
          "type": "journal.reflection.written",
          "userId": "oidc-subject-2",
          "occurredAt": "2026-08-24T11:00:00Z",
          "sourceApp": "journal",
          "schemaVersion": 1,
          "payload": {}
        },
        "expected_user_id": "oidc-subject-1",
        "now": "2026-08-24T12:00:00Z"
      },
      "expected_code": "event_user_mismatch"
    },
    {
      "name": "event exactly seven days old is valid",
      "input": {
        "envelope": {
          "eventId": "event-age-boundary",
          "type": "relax.session.completed",
          "userId": "oidc-subject-1",
          "occurredAt": "2026-08-17T12:00:00Z",
          "sourceApp": "relax",
          "schemaVersion": 1,
          "payload": {}
        },
        "expected_user_id": "oidc-subject-1",
        "now": "2026-08-24T12:00:00Z"
      },
      "expected_code": null
    },
    {
      "name": "event older than seven days by one second is too old",
      "input": {
        "envelope": {
          "eventId": "event-age-over-boundary",
          "type": "relax.session.completed",
          "userId": "oidc-subject-1",
          "occurredAt": "2026-08-17T11:59:59Z",
          "sourceApp": "relax",
          "schemaVersion": 1,
          "payload": {}
        },
        "expected_user_id": "oidc-subject-1",
        "now": "2026-08-24T12:00:00Z"
      },
      "expected_code": "event_too_old"
    },
    {
      "name": "future event is not too old",
      "input": {
        "envelope": {
          "eventId": "event-in-future",
          "type": "sololeveling.dailies.completed",
          "userId": "oidc-subject-1",
          "occurredAt": "2026-08-24T12:00:01Z",
          "sourceApp": "sololeveling",
          "schemaVersion": 1,
          "payload": {}
        },
        "expected_user_id": "oidc-subject-1",
        "now": "2026-08-24T12:00:00Z"
      },
      "expected_code": null
    },
    {
      "name": "unsupported schema wins over other validation errors",
      "input": {
        "envelope": {
          "eventId": "",
          "type": "Focus.completed",
          "userId": "oidc-subject-2",
          "occurredAt": "2026-08-17T11:59:59Z",
          "sourceApp": "tiefgang",
          "schemaVersion": 2,
          "payload": {}
        },
        "expected_user_id": "oidc-subject-1",
        "now": "2026-08-24T12:00:00Z"
      },
      "expected_code": "event_schema_unsupported"
    }
  ]
}
