    {"name": "non-ascii-byte", "prefix": "rev-", "requirement": "required", "ifMatch": ["\"rev-4é\""], "outcome": {"status": 400, "code": "invalid_if_match", "reason": "non_ascii"}},
    {"name": "empty-prefix", "prefix": "", "requirement": "required", "ifMatch": ["\"42\""], "outcome": {"revision": 42}},
    {"name": "empty-prefix-rejects-prefixed-tag", "prefix": "", "requirement": "optional", "ifMatch": ["\"rev-42\""], "outcome": {"status": 400, "code": "invalid_if_match", "reason": "invalid_revision"}},
    {"name": "colon-prefix", "prefix": "revision:", "requirement": "optional", "ifMatch": ["\"revision:42\""], "outcome": {"revision": 42}},
    {"name": "runtime-resource-prefix", "prefix": "0b8f5e2c-6a4b-4c1e-9f3a-2d7e8c9b1a40:", "requirement": "optional", "ifMatch": ["\"0b8f5e2c-6a4b-4c1e-9f3a-2d7e8c9b1a40:1767225600000000\""], "outcome": {"revision": 1767225600000000}},
    {"name": "runtime-resource-prefix-other-resource", "prefix": "0b8f5e2c-6a4b-4c1e-9f3a-2d7e8c9b1a40:", "requirement": "optional", "ifMatch": ["\"5c7d1e9a-2b3f-4a6c-8d0e-1f2a3b4c5d6e:1767225600000000\""], "outcome": {"status": 400, "code": "invalid_if_match", "reason": "prefix_mismatch"}}
  ],
  "formatCases": [
    {"prefix": "rev-", "revision": 42, "etag": "\"rev-42\""},
