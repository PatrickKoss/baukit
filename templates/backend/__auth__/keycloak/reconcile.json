{
  "environmentClass": "development",
  "serviceAccountRoles": {"{{ context.app_name }}-backend": ["manage-users"]},
  "realmFields": [
    "displayName",
    "enabled",
    "sslRequired",
    "registrationAllowed",
    "loginWithEmailAllowed",
    "loginTheme",
    "passwordPolicy",
    "bruteForceProtected"
  ],
  "clients": [
    {
      "clientId": "{{ context.app_name }}-backend",
      "activeOrigins": [],
      "activeRedirectUris": []
    }{% if context.web %},
    {
      "clientId": "{{ context.app_name }}-web",
      "activeOrigins": ["http://localhost:5173"],
      "activeRedirectUris": ["http://localhost:5173/*"]
    }{% endif %}{% if context.mobile %},
    {
      "clientId": "{{ context.app_name }}-mobile",
      "activeOrigins": [],
      "activeRedirectUris": ["{{ context.app_name }}://oauth"]
    }{% endif %}
  ],
  "users": ["test"]
}
